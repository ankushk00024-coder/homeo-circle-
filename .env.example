# Homeo Circle — environment variables for the website (Vercel / local dev)
#
# Copy to .env.local for local development. In Vercel, add the same two
# variables under Project → Settings → Environment Variables.
# Find both values in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Leave both unset to run in demo mode (sample data, demo logins).
#
# NEVER put the service_role key here or in Vercel: anything starting with
# VITE_ is shipped to every visitor's browser. The Edge Function receives the
# service_role key automatically from Supabase.
