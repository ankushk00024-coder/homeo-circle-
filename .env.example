# Homeo Circle — Environment Configuration Template
# ==============================================================================

# Supabase Client Configuration (Safe for frontend bundle)
# Leave these unset to run in DEMO MODE: sample data in localStorage and
# one-click demo profiles on the login page. Setting them switches the app to
# live mode, where demo logins and mock-data fallbacks are disabled.
# Obtain your Project URL and Anon Key from: Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Administrative / Server-Only Variables (DO NOT expose in client bundles or prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-trusted-server-only

# Email Notification Provider (Optional — external email delivery)
# When unconfigured, in-app real-time notifications operate seamlessly.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# RESEND_API_KEY=re_your_resend_api_key
# NOTIFICATION_FROM_EMAIL=notifications@homeocircle.in
